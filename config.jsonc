{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 44,
  "spacing": 0,
  "margin-top": 5,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/omarchy",
    "hyprland/workspaces",
    "custom/active_window",
    "custom/media"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "custom/vitals",
    "custom/weather",
    "bluetooth",
    "network",
    "pulseaudio",
    "battery",
    "custom/power"
  ],

  /* ---------------- CORE MODULES ---------------- */

  "custom/omarchy": {
    "format": "󱂬",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip": false
  },

  "custom/active_window": {
    "exec": "~/.config/waybar/window.sh",
    "return-type": "json",
    "markup": true
  },

  "custom/media": {
    "exec": "~/.config/waybar/media.sh",
    "interval": 1,
    "return-type": "json",
    "markup": true,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": []
    }
  },

  /* ---------------- SYSTEM ---------------- */

  "custom/vitals": {
    "exec": "~/.config/waybar/vitals.sh",
    "interval": 2,
    "return-type": "json",
    "on-click": "omarchy-launch-or-focus-tui btop",
    "format": "{icon} {text}",
    "format-icons": {
        "vitals": ""
    }
  },

  /* ---------------- CLOCK ---------------- */

  "clock": {
    "format": "󰅐 {:%I:%M %p}",
    "format-alt": "󰃭 {:%A, %d %B %Y}",
    "tooltip-format": "<span size='16pt' font='JetBrainsMono Nerd Font' weight='bold' foreground='#cba6f7'>󰃭  {:%B %Y}</span>\n<span foreground='#6c7086'>━━━━━━━━━━━━━━━━━━━━</span>\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8' background='#f38ba833'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  /* ---------------- NETWORK ---------------- */

  "network": {
    "interval": 5,
    "format": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰌘",
    "format-disconnected": "󰤮",
    "tooltip-format": "<span size='13000' foreground='#f5c2e7'>󰤨   <b>Network Status</b></span>\n<span foreground='#6c7086'>━━━━━━━━━━━━━━━━━━━━━</span>\n<tt><b>󰈀 Interface:  </b> {ifname}</tt>\n<tt><b>󰩟 IP Address: </b> {ipaddr}</tt>",
    "on-click": "omarchy-launch-wifi"
  },

  /* ---------------- BATTERY ---------------- */

  "battery": {
    "interval": 10,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "on-click": "omarchy-menu power"
  },

  /* ---------------- AUDIO ---------------- */

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "omarchy-launch-audio",
    "on-click-right": "pamixer -t"
  },

  /* ---------------- BLUETOOTH ---------------- */

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "omarchy-launch-bluetooth"
  },

  /* ---------------- CUSTOM ---------------- */

  "custom/weather": {
    "exec": "~/.config/waybar/weather.sh",
    "interval": 3600,
    "return-type": "json",
    "signal": 9,
    "on-click": "pkill -RTMIN+9 waybar"
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "omarchy-menu power",
    "tooltip": false
  }
}
